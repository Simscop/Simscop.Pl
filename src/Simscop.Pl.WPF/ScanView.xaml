<liftui:Window
    x:Class="Simscop.Pl.WPF.ScanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:liftui="https://github.com/pchuan98/Lift.UI"
    xmlns:local="clr-namespace:Simscop.Pl.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Simscop.Pl.WPF.ViewModels"
    Title="{Binding Title}"
    Width="600"
    Height="350"
    d:DataContext="{d:DesignInstance vm:ScanViewModel}"
    ResizeMode="CanMinimize"
    Topmost="True"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>

            <StackPanel IsEnabled="True">
                <UniformGrid Margin="0,10" Columns="2">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text="X起始位置(μm)" />

                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding XStart}"
                                TextAlignment="Left" />
                        </StackPanel>

                    </DockPanel>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text="X终止位置(μm)" />
                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding XEnd}"
                                TextAlignment="Left" />
                        </StackPanel>

                    </DockPanel>
                </UniformGrid>
                <UniformGrid Margin="0,10" Columns="2">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text="Y起始位置(μm)" />

                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding YStart}"
                                TextAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text="Y终止位置(μm)" />
                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding YEnd}"
                                TextAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                </UniformGrid>
                <UniformGrid Columns="3">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text="X步长(μm)" />

                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding XStep}"
                                TextAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text=" Y步长(μm) " />
                            <TextBox
                                Height="34"
                                Margin="5,0"
                                Padding="10,0,0,0"
                                VerticalContentAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding YStep}"
                                TextAlignment="Left" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,5"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Text=" 倍镜选项 " />
                            <ComboBox
                                Width="170"
                                Height="35"
                                ItemsSource="{Binding SelectLite}"
                                SelectedIndex="{Binding SelectIndex, Mode=TwoWay}" />
                        </StackPanel>
                    </DockPanel>

                </UniformGrid>
            </StackPanel>

            <UniformGrid Margin="0,10" Columns="3">
                <DockPanel Grid.Column="2">
                    <Button
                        Width="Auto"
                        Height="34"
                        Margin="5,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SetXYStartPointCommand}"
                        Content="设为起点"
                        FontSize="12"
                        IsEnabled="{Binding XYEnable}" />
                </DockPanel>
                <DockPanel Grid.Column="3">
                    <Button
                        Width="Auto"
                        Height="34"
                        Margin="5,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SetXYEndPointCommand}"
                        Content="设为终点"
                        FontSize="12"
                        IsEnabled="{Binding XYEnable}" />
                </DockPanel>
                <DockPanel Grid.Column="4">
                    <Button
                        Width="Auto"
                        Height="34"
                        Margin="5,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding StartScanCommand}"
                        Content="{Binding IsXYStart}"
                        FontSize="12"
                        IsEnabled="True" />
                </DockPanel>

            </UniformGrid>
            <DockPanel>
                <Button
                    Width="100"
                    Height="34"
                    Margin="5,0"
                    Padding="0"
                    Command="{Binding OpenFolderCommand}"
                    Content="打开"
                    DockPanel.Dock="Right" />
                <Button
                    Width="100"
                    Height="34"
                    Margin="5,0"
                    Padding="0"
                    Command="{Binding SelectRootCommand}"
                    Content="选择文件夹"
                    DockPanel.Dock="Right" />
                <TextBox
                    Height="34"
                    Margin="5,0"
                    Padding="10,0,0,0"
                    VerticalContentAlignment="Center"
                    DockPanel.Dock="Left"
                    Text="{Binding Root}"
                    TextAlignment="Left" />
            </DockPanel>

            <!--<UniformGrid>
                <Button Command="{Binding StartPosCommand}" Content="起点" />
                <Button Command="{Binding EndPosCommand}" Content="终点" />
            </UniformGrid>-->

        </StackPanel>

    </Grid>
</liftui:Window>
